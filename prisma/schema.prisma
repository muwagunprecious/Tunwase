generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String   @default("Adetunwase Adenle")
  email     String   @unique @default("adetunwase@animationhub.tv")
  title     String   @default("Guinness World Record Artist, Educator & Founder")
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeFact {
  id               String   @id @default(cuid())
  fact             String
  entity           String
  category         String
  source           String
  sourceUrl        String?
  dateCollected    DateTime @default(now())
  lastVerified     DateTime @default(now())
  confidence       String   @default("High")
  privacy          String   @default("Public")
  staleAfterDays   Int      @default(90)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  title     String
  entity    String
  category  String
  content   String
  source    String?
  confidence String  @default("High")
  privacy   String   @default("Public")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialPost {
  id               String   @id @default(cuid())
  platform         String
  entity           String   @default("PERSONAL")
  topic            String
  content          String
  category         String
  hashtags         String
  likes            Int      @default(0)
  comments         Int      @default(0)
  shares           Int      @default(0)
  views            Int      @default(0)
  engagementRate   Float    @default(0.0)
  isHighPerformer  Boolean  @default(false)
  postedAt         DateTime @default(now())
}

model ContentDraft {
  id               String   @id @default(cuid())
  platform         String
  entity           String   @default("PERSONAL")
  topic            String
  hook             String?
  content          String
  visualSuggestion String?
  cta              String?
  hashtags         String?
  status           String   @default("Draft")
  rejectionReason  String?
  userEdits        String?
  targetDate       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Trend {
  id                    String   @id @default(cuid())
  title                 String
  category              String
  summary               String
  relevanceAdetun       Int      @default(85)
  relevanceAnimationHub Int      @default(80)
  relevanceFoundation   Int      @default(75)
  timelinessScore       Int      @default(90)
  brandFitScore         Int      @default(88)
  anglesJson            String
  source                String
  sourceUrl             String?
  discoveredAt          DateTime @default(now())
}

model Contact {
  id         String   @id @default(cuid())
  name       String
  role       String
  company    String
  email      String?
  emailType  String?
  phone      String?
  linkedin   String?
  website    String?
  source     String
  confidence String   @default("High")
  isVerified Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ResearchDossier {
  id             String   @id @default(cuid())
  query          String
  targetType     String
  targetName     String
  roleOrIndustry String?
  company        String?
  summary        String
  overviewJson   String
  whyItMatters   String
  confidence     String   @default("High")
  sourcesJson    String
  createdAt      DateTime @default(now())
}

model Meeting {
  id                    String   @id @default(cuid())
  title                 String
  personName            String
  personRole            String
  company               String
  meetingDate           DateTime
  status                String   @default("Upcoming")
  executiveSummary      String?
  whoTheyAre            String?
  whatTheyCareAbout     String?
  connectionsToAdetun   String?
  talkingPointsJson      String?
  thingsToAvoidJson      String?
  potentialPartnerships String?
  isPrivateContext      Boolean  @default(true)
  publicShareableNotes  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model DailyBriefing {
  id                    String   @id @default(cuid())
  date                  String
  executiveHeadline     String
  threeKeyNewsJson      String
  twoRelevantTrendsJson String
  oneContentOppJson     String
  recommendedDraftsJson String
  meetingsOverview      String?
  createdAt             DateTime @default(now())
}

model Memory {
  id        String   @id @default(cuid())
  category  String
  entity    String   @default("PERSONAL")
  content   String
  source    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StyleProfile {
  id               String   @id @default(cuid())
  entity           String   @unique @default("PERSONAL")
  tone             String   @default("Direct, visionary, warm, conversational, punchy")
  prohibitedRules  String   @default("No em dashes; No corporate cliches; No fake hype")
  hookPatterns     String
  closingPatterns  String
  learnedRulesJson String
  updatedAt        DateTime @updatedAt
}

model Task {
  id                   String   @id @default(cuid())
  title                String
  description          String?
  priority             String   @default("MEDIUM")
  status               String   @default("INBOX")
  deadline             DateTime?
  entity               String   @default("PERSONAL")
  projectName          String?
  projectId            String?
  personResponsible    String?  @default("Adetunwase Adenle")
  dependenciesJson     String?
  notes                String?
  reminderScheduleJson String?
  completedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Reminder {
  id              String   @id @default(cuid())
  taskId          String?
  title           String
  triggerAt       DateTime
  type            String   @default("DATE")
  status          String   @default("PENDING")
  priority        String   @default("MEDIUM")
  escalationLevel Int      @default(1)
  recurrenceRule  String?
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())
}

model Project {
  id                    String   @id @default(cuid())
  name                  String
  entity                String   @default("ANIMATION_HUB")
  objective             String
  expectedOutcome       String?
  status                String   @default("ACTIVE")
  healthScore           Int      @default(85)
  healthReason          String?
  deadline              DateTime?
  predictedCompletionDate DateTime?
  milestonesJson        String?
  risksJson             String?
  decisionsJson         String?
  budget                String?
  communicationPlan     String?
  successMetrics        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now())
}

model ActionItem {
  id          String   @id @default(cuid())
  title       String
  description String
  type        String
  status      String   @default("NEEDS_APPROVAL")
  payloadJson String?
  riskLevel   String   @default("MEDIUM")
  waitingOn   String?
  executedAt  DateTime?
  createdAt   DateTime @default(now())
}

model Opportunity {
  id                String   @id @default(cuid())
  title             String
  entity            String   @default("ANIMATION_HUB")
  type              String
  whyItMatters      String
  potentialValue    String?
  relevanceAdetun   Int      @default(90)
  recommendedAction String
  deadline          DateTime?
  contactName       String?
  contactInfo       String?
  source            String
  status            String   @default("NEW")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())
}

model RelationshipFollowUp {
  id                  String   @id @default(cuid())
  personName          String
  company             String
  role                String?
  lastInteractionDate DateTime @default(now())
  nextFollowUpDate    DateTime?
  commitmentsByAdetun String?
  commitmentsByThem   String?
  waitingOnThem       Boolean  @default(false)
  status              String   @default("PENDING")
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now())
}

model DecisionRecord {
  id             String   @id @default(cuid())
  topic          String
  optionA        String
  optionB        String
  criteriaJson   String
  recommendation String
  rationale      String
  status         String   @default("DECIDED")
  entity         String   @default("PERSONAL")
  decidedAt      DateTime @default(now())
}

model StrategicRoadmap {
  id                    String   @id @default(cuid())
  entity                String   @default("ANIMATION_HUB")
  title                 String
  objective             String
  currentState          String
  roadmap12MonthJson    String
  quarterlyGoalsJson    String
  monthlyMilestonesJson String
  keyMetricsJson        String
  requiredResourcesJson String
  next7DaysJson         String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now())
}

model OperationsReview {
  id                String   @id @default(cuid())
  date              String
  type              String
  prioritiesJson    String
  overdueJson       String
  bottlenecksJson   String
  healthSummaryJson String
  blindSpotsJson    String
  aiReflection      String
  createdAt         DateTime @default(now())
}

model AiConversation {
  id        String      @id
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime
  AiMessage AiMessage[]
}

model AiMessage {
  id             String         @id
  conversationId String
  sender         String
  content        String
  citations      String?
  intent         String?
  createdAt      DateTime       @default(now())
  AiConversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id
  action    String
  details   String
  user      String   @default("Admin")
  createdAt DateTime @default(now())
}

model CommunityInfo {
  id              String   @id
  name            String   @default("Ijora-Badia")
  location        String   @default("Lagos State, Nigeria")
  description     String
  challenges      String[]
  interventions   String[]
  opportunities   String[]
  youthPopulation String   @default("Estimated thousands of children & youth")
  updatedAt       DateTime
}

model Document {
  id            String          @id
  orgId         String
  title         String
  fileType      String
  fileSize      String
  uploadDate    DateTime        @default(now())
  category      String
  factsCount    Int             @default(0)
  metricsCount  Int             @default(0)
  content       String
  Organization  Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  DocumentChunk DocumentChunk[]
}

model DocumentChunk {
  id         String   @id
  documentId String
  content    String
  chunkIndex Int
  metadata   String?
  Document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model EmailMessage {
  id         String        @id
  sender     String
  subject    String
  snippet    String
  body       String
  receivedAt DateTime      @default(now())
  category   EmailCategory @default(GRANT_OPPORTUNITY)
  matchScore Int?
  aiSummary  String
  draftReply String?
  status     EmailStatus   @default(PENDING_APPROVAL)
}

model FactConflict {
  id               String    @id
  topic            String
  claimA           String
  claimASources    String[]
  claimB           String
  claimBSources    String[]
  recommendedClaim String
  recommendReason  String
  status           String    @default("OPEN")
  resolvedClaim    String?
  createdAt        DateTime  @default(now())
  WebFact          WebFact[]
}

model Founder {
  id           String   @id
  name         String   @default("Adetunwase Adenle")
  title        String   @default("Founder & Creative Director")
  bio          String
  story        String
  education    String
  philosophy   String
  achievements String[]
  awards       String[]
  mediaLinks   String[]
  verified     Boolean  @default(true)
  updatedAt    DateTime
}

model GrantApplication {
  id               String           @id
  grantId          String
  title            String
  content          String
  sections         String
  missingItems     String[]
  status           String           @default("Draft")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  GrantOpportunity GrantOpportunity @relation(fields: [grantId], references: [id], onDelete: Cascade)
}

model GrantOpportunity {
  id               String             @id
  orgId            String
  title            String
  funder           String
  deadline         String
  amount           String
  geography        String
  eligibility      String
  matchScore       Int
  classification   GrantCategory      @default(CAN_PREPARE)
  missionScore     Int                @default(95)
  programScore     Int                @default(90)
  geoScore         Int                @default(100)
  beneficiaryScore Int                @default(95)
  fundingScore     Int                @default(85)
  eligibilityScore Int                @default(90)
  strategicScore   Int                @default(95)
  matchReasons     String[]
  missingInfo      String[]
  recommendation   String
  status           String             @default("Discovered")
  createdAt        DateTime           @default(now())
  GrantApplication GrantApplication[]
  Organization     Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model ImpactMetric {
  id           String       @id
  orgId        String
  metricName   String
  value        String
  numericVal   Int          @default(0)
  unit         String
  category     String
  year         Int          @default(2026)
  isVerified   Boolean      @default(true)
  sourceDoc    String?
  createdAt    DateTime     @default(now())
  Organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model KnowledgeEntity {
  id                                                                  String              @id
  canonicalName                                                       String              @unique
  entityType                                                          String
  description                                                         String?
  aliases                                                             String[]
  confidence                                                          String              @default("HIGH")
  needsAdminReview                                                    Boolean             @default(false)
  createdAt                                                           DateTime            @default(now())
  KnowledgeRelation_KnowledgeRelation_sourceEntityIdToKnowledgeEntity KnowledgeRelation[] @relation("KnowledgeRelation_sourceEntityIdToKnowledgeEntity")
  KnowledgeRelation_KnowledgeRelation_targetEntityIdToKnowledgeEntity KnowledgeRelation[] @relation("KnowledgeRelation_targetEntityIdToKnowledgeEntity")
}

model KnowledgeRelation {
  id                                                                String          @id
  sourceEntityId                                                    String
  targetEntityId                                                    String
  relationType                                                      String
  confidence                                                        Float           @default(0.9)
  createdAt                                                         DateTime        @default(now())
  KnowledgeEntity_KnowledgeRelation_sourceEntityIdToKnowledgeEntity KnowledgeEntity @relation("KnowledgeRelation_sourceEntityIdToKnowledgeEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  KnowledgeEntity_KnowledgeRelation_targetEntityIdToKnowledgeEntity KnowledgeEntity @relation("KnowledgeRelation_targetEntityIdToKnowledgeEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Organization {
  id               String             @id
  name             String             @default("Slum Art Foundation")
  location         String             @default("Ijora-Badia, Lagos, Nigeria")
  foundedYear      Int                @default(2018)
  mission          String
  vision           String
  overview         String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  Document         Document[]
  GrantOpportunity GrantOpportunity[]
  ImpactMetric     ImpactMetric[]
  Program          Program[]
  VerifiedFact     VerifiedFact[]
}

model Program {
  id           String       @id
  orgId        String
  title        String
  slug         String       @unique
  category     String
  description  String
  objectives   String[]
  status       String       @default("Active")
  createdAt    DateTime     @default(now())
  Organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model ResearchTask {
  id              String   @id
  query           String
  targetCategory  String   @default("ORGANIZATION")
  status          String   @default("COMPLETED")
  sourcesAnalyzed Int      @default(0)
  factsDiscovered Int      @default(0)
  entitiesFound   Int      @default(0)
  conflictsFound  Int      @default(0)
  logMessages     String[]
  runAt           DateTime @default(now())
}

model SlumartTimelineEvent {
  id          String   @id
  dateStr     String
  year        Int      @default(2018)
  eventTitle  String
  description String
  category    String   @default("MILESTONE")
  sourceUrl   String?
  confidence  Int      @default(90)
  createdAt   DateTime @default(now())
}

model SourceDocument {
  id          String    @id
  sourceId    String
  contentHash String
  cleanText   String
  rawHtml     String?
  httpStatus  Int       @default(200)
  fetchedAt   DateTime  @default(now())
  WebSource   WebSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

model VerifiedFact {
  id           String       @id
  orgId        String
  factText     String
  category     String
  status       FactStatus   @default(VERIFIED)
  sourceTitle  String
  approvedBy   String       @default("Administrator")
  confidence   Int          @default(98)
  updatedAt    DateTime
  createdAt    DateTime     @default(now())
  Organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model WebFact {
  id             String        @id
  subject        String        @default("SLUMART")
  factText       String
  category       String        @default("organization_history")
  sourceId       String?
  sourceUrl      String
  sourceType     String        @default("media")
  confidence     Float         @default(0.92)
  status         String        @default("PUBLICLY_REPORTED")
  sourceDate     String?
  created_at     DateTime      @default(now())
  lastVerifiedAt DateTime      @default(now())
  conflictId     String?
  FactConflict   FactConflict? @relation(fields: [conflictId], references: [id])
  WebSource      WebSource?    @relation(fields: [sourceId], references: [id])
}

model WebSource {
  id                 String           @id
  url                String           @unique
  title              String
  domain             String
  sourceType         String           @default("media")
  tier               Int              @default(2)
  credibilityScore   Int              @default(85)
  lastCrawledAt      DateTime?
  status             String           @default("ACTIVE")
  factsCount         Int              @default(0)
  adminOverrideScore Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  SourceDocument     SourceDocument[]
  WebFact            WebFact[]
}

enum EmailCategory {
  GRANT_OPPORTUNITY
  PARTNERSHIP
  FUNDING
  IMPORTANT
  EVENT
  MEDIA
  GENERAL
  URGENT
}

enum EmailStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
}

enum FactStatus {
  VERIFIED
  NEEDS_REVIEW
  REJECTED
  PUBLIC_SOURCE
}

enum GrantCategory {
  CAN_PREPARE
  ADMIN_REVIEW
  NOT_A_MATCH
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}
